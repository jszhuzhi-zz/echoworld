{
  "envId": "georgezhu-0gnrnw9ae9fca59a",
  "version": "2.0",
  "framework": {
    "name": "node",
    "plugins": {
      "node": {
        "use": "@cloudbase/framework-plugin-node",
        "inputs": {
          "name": "echoworld",
          "entry": "dist/index.js",
          "path": "/",
          "buildCommand": "npm install && npm run build",
          "envVariables": {
            "ZHIPU_API_KEY": "${env.ZHIPU_API_KEY}",
            "ZHIPU_MODEL": "glm-4-flash",
            "PORT": "3000"
          }
        }
      }
    }
  }
}
